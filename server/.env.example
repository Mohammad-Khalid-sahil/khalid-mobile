PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/khalid_mobile
# در حالت توسعه آدرس کلاینت؛ در حالت production (یک پورت) می‌تواند خالی باشد
CLIENT_URL=http://localhost:5173
# حتماً یک رشتهٔ طولانی و تصادفی بگذارید
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h
# مسیر ذخیرهٔ فایل‌های پشتیبان
BACKUP_DIR=./backups
# اگر پشت proxy/HTTPS هستید 1 بگذارید
TRUST_PROXY=0
